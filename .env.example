# Binance Testnet API Credentials (Sign up at https://testnet.binancefuture.com)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# Environment (testnet for development, production for live trading)
ENVIRONMENT=testnet

# Trading Settings
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_LEVERAGE=1
MAX_ORDER_SIZE=1.0
LOG_LEVEL=INFO
